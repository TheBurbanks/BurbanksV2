function Library:setTheme(data, color)
	local themeName
	local themeColor

	if typeof(data) == "table" then
		themeName = data.theme or data.Theme
		themeColor = data.color3 or data.Color or data.color
	else
		themeName = data
		themeColor = color
	end

	if self.theme[themeName] == nil or typeof(themeColor) ~= "Color3" then
		return false
	end

	self.theme[themeName] = themeColor

	for _, binding in ipairs(self._themeObjects) do
		local object = binding.Object
		if object and object.Parent and binding.Theme == themeName then
			object[binding.Property] = themeColor
		end
	end

	for _, refresher in ipairs(self._themeRefreshers) do
		local success, message = pcall(refresher)
		if not success then
			warn("[Burbanks theme refresh error]:", message)
		end
	end

	return true
end
Library.SetTheme = Library.setTheme

function Library:toggle(forceState)
	if self._busy then return end

	if forceState ~= nil then
		self._visible = forceState == true
	else
		self._visible = not self._visible
	end

	self._busy = true

	if self._visible then
		self.main.Visible = true
		self.main.Size = UDim2.fromOffset(self.openSize.X.Offset, 0)
		tween(self.main, 0.22, {
			Size = self.openSize,
			Position = self.openPosition,
		}).Completed:Wait()
	else
		self.openPosition = self.main.Position
		self.openSize = self.main.Size
		tween(self.main, 0.2, {
			Size = UDim2.fromOffset(self.main.AbsoluteSize.X, 0),
		}).Completed:Wait()
		self.main.Visible = false
	end

	self._busy = false
end
Library.Toggle = Library.toggle

function Library:Destroy()
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	self.container:Destroy()
end

function Library:Notify(data)
	data = data or {}

	local holder = create("Frame", {
		Parent = self.container,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.fromOffset(0, 140),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 50,
	})
	bindTheme(self, holder, "BackgroundColor3", "Card")
	holder.BackgroundTransparency = 0.075
	corner(holder, 12)

	local holderStroke = stroke(holder, self.theme.Stroke, 0.5, 1)
	bindTheme(self, holderStroke, "Color", "Stroke")

	local progressTrack = create("Frame", {
		Parent = holder,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 3),
		BorderSizePixel = 0,
		ZIndex = 52,
	})
	bindTheme(self, progressTrack, "BackgroundColor3", "Background2")

	local progressFill = create("Frame", {
		Parent = progressTrack,
		Size = UDim2.new(0, 0, 1, 0),
		BorderSizePixel = 0,
		ZIndex = 53,
	})
	bindTheme(self, progressFill, "BackgroundColor3", "Accent")

	local title = createLabel(
		self,
		holder,
		tostring(data.title or data.Title or "NOTIFICATION"),
		16,
		Enum.Font.GothamBold
	)
	title.Position = UDim2.fromOffset(20, 16)
	title.Size = UDim2.new(1, -40, 0, 28)
	title.ZIndex = 51

	local text = createLabel(
		self,
		holder,
		tostring(data.text or data.Text or ""),
		14,
		Enum.Font.GothamMedium
	)
	text.Position = UDim2.fromOffset(20, 50)
	text.Size = UDim2.new(1, -40, 0, 66)
	text.TextWrapped = true
	text.TextYAlignment = Enum.TextYAlignment.Top
	text.ZIndex = 51
	bindTheme(self, text, "TextColor3", "Muted")
	text.TextTransparency = 0.5

	local measured = TextService:GetTextSize(
		text.Text,
		14,
		Enum.Font.GothamMedium,
		Vector2.new(480, 80)
	)

	local width = math.clamp(measured.X + 100, 430, 680)
	tween(holder, 0.2, {Size = UDim2.fromOffset(width, 140)})

	local closed = false
	local progressTween

	local function close(result)
		if closed then return end
		closed = true
		if progressTween then progressTween:Cancel() end
		safeCall(data.callback or data.Callback, result)
		tween(holder, 0.2, {Size = UDim2.fromOffset(0, 140)}).Completed:Wait()
		holder:Destroy()
	end

	local duration = tonumber(data.duration) or 5

	progressTween = tween(
		progressFill,
		duration,
		{Size = UDim2.new(1, 0, 1, 0)},
		Enum.EasingStyle.Linear,
		Enum.EasingDirection.Out
	)

	progressTween.Completed:Connect(function(playbackState)
		if playbackState == Enum.PlaybackState.Completed and holder.Parent then
			close(nil)
		end
	end)

	return {
		Instance = holder,
		Close = close,
	}
end

function Library:addPage(data)
	data = data or {}

	local page = setmetatable({}, Page)

	page.library = self
	page.title = tostring(data.title or data.Title or "PAGE")
	page.sections = {}

	local button = create("TextButton", {
		Parent = self.pagesContainer,
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
	})

	local background = create("Frame", {
		Parent = button,
		Size = UDim2.new(1, -1, 1, 0),
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
	})
	bindTheme(self, background, "BackgroundColor3", "Card")
	corner(background, 8)

	local accent = create("Frame", {
		Parent = background,
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.fromOffset(3, 20),
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
	})
	bindTheme(self, accent, "BackgroundColor3", "Accent")
	corner(accent, 5)

	local iconName = data.icon or data.Icon
	local fallbackIconText = tostring(data.iconText or data.IconText or "◆")
	local icon

	if iconName ~= nil then
		local iconValue = tostring(iconName)

		if iconValue:match("^rbxassetid://") or iconValue:match("^https?://") or tonumber(iconValue) then
			local imageUrl = tonumber(iconValue) and ("rbxassetid://" .. iconValue) or iconValue
			icon = create("ImageLabel", {
				Parent = background,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(12, 7),
				Size = UDim2.fromOffset(18, 18),
				Image = imageUrl,
				ScaleType = Enum.ScaleType.Fit,
			})
			bindTheme(self, icon, "ImageColor3", "Muted")
		else
			local lucide = getLucide()
			if lucide and typeof(lucide.ImageLabel) == "function" then
				local success, lucideIcon = pcall(function()
					return lucide.ImageLabel(string.lower(iconValue), 48, {
						Parent = background,
						BackgroundTransparency = 1,
						Position = UDim2.fromOffset(12, 7),
						Size = UDim2.fromOffset(18, 18),
						ScaleType = Enum.ScaleType.Fit,
					})
				end)
				if success then
					icon = lucideIcon
					bindTheme(self, icon, "ImageColor3", "Muted")
				else
					warn(("[Burbanks] Invalid Lucide icon '%s': %s"):format(iconValue, tostring(lucideIcon)))
				end
			end
		end
	end

	if not icon then
		icon = createLabel(self, background, fallbackIconText, 12, Enum.Font.GothamBold)
		icon.Position = UDim2.fromOffset(10, 0)
		icon.Size = UDim2.fromOffset(24, 32)
		icon.TextXAlignment = Enum.TextXAlignment.Center
