local function createBoxedModule(section, height)
	local holder = create("Frame", {
		Parent = section.moduleContainer,
		Size = UDim2.new(1, -0, 0, height or 38),
		BorderSizePixel = 0,
	})
	bindTheme(section.library, holder, "BackgroundColor3", "Card2")
	holder.BackgroundTransparency = 0
	corner(holder, 8)

	local outline = stroke(holder, section.library.theme.Stroke, 0.5, 1)
	bindTheme(section.library, outline, "Color", "Stroke")

	return holder
end

local function createBoxedTitle(section, parent, title, rightPadding)
	local label = createLabel(
		section.library,
		parent,
		tostring(title or "Module"),
		12,
		Enum.Font.GothamMedium
	)
	label.Position = UDim2.fromOffset(12, 0)
	label.Size = UDim2.new(1, -(rightPadding or 24), 1, 0)
	bindTheme(section.library, label, "TextColor3", "Text")
	label.TextTransparency = 0.2
	return label
end

