function Section:addKeybind(data)
	data = data or {}

	local options = {
		title = tostring(data.title or data.Title or "KEYBIND"),
		key = data.key or Enum.KeyCode.Unknown,
		gameProcessedEvent = data.gameProcessedEvent == true,
		callback = data.callback or data.Callback or function() end,
		changedCallback = data.changedCallback or function() end,
	}

	local module = createBoxedModule(self, 38)
	local button = create("TextButton", {
		Parent = module,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	})

	local title = createBoxedTitle(self, button, options.title, 120)

	local keyBox = create("TextLabel", {
		Parent = button,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(90, 22),
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = formatKey(options.key),
		TextSize = 9,
	})
	bindTheme(self.library, keyBox, "BackgroundColor3", "Background2")
	keyBox.BackgroundTransparency = 0
	bindTheme(self.library, keyBox, "TextColor3", "Accent")
	keyBox.TextTransparency = 0.25
	corner(keyBox, 6)

	local keyStroke = stroke(keyBox, self.library.theme.Stroke, 0.5, 1)
	bindTheme(self.library, keyStroke, "Color", "Stroke")

	local listening = false

	button.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		keyBox.Text = "PRESS KEY"

		task.spawn(function()
			local inputObject
			repeat
				inputObject = UserInputService.InputBegan:Wait()
			until inputObject.UserInputType == Enum.UserInputType.Keyboard

			if inputObject.KeyCode == Enum.KeyCode.Escape or inputObject.KeyCode == Enum.KeyCode.Backspace then
				options.key = Enum.KeyCode.Unknown
			else
				options.key = inputObject.KeyCode
			end

			keyBox.Text = formatKey(options.key)
			listening = false
			safeCall(options.changedCallback, options.key)
		end)
	end)

	local connection = UserInputService.InputBegan:Connect(function(inputObject, processed)
		if listening or inputObject.KeyCode ~= options.key or options.key == Enum.KeyCode.Unknown or processed ~= options.gameProcessedEvent then
			return
		end
		safeCall(options.callback)
	end)

	self.library._connections[#self.library._connections + 1] = connection

	local controller = {
		Instance = module,
		Options = options,
	}

	function controller:SetKey(key)
		if typeof(key) == "InputObject" then
			key = key.KeyCode
		end
		options.key = typeof(key) == "EnumItem" and key or Enum.KeyCode.Unknown
		keyBox.Text = formatKey(options.key)
		safeCall(options.changedCallback, options.key)
		return self
	end

	function controller:Update(newOptions)
		newOptions = newOptions or {}
		if newOptions.title ~= nil then
			options.title = tostring(newOptions.title)
			title.Text = options.title
		end
		if newOptions.key ~= nil then
			self:SetKey(newOptions.key)
		end
		if newOptions.gameProcessedEvent ~= nil then
			options.gameProcessedEvent = newOptions.gameProcessedEvent == true
		end
		if typeof(newOptions.callback) == "function" then
			options.callback = newOptions.callback
		end
		if typeof(newOptions.changedCallback) == "function" then
			options.changedCallback = newOptions.changedCallback
		end
		return self
	end

	self.modules[#self.modules + 1] = controller
	return controller
end
