--// Lucide Roblox
local LUCIDE_MODULE_URL = "https://github.com/latte-soft/lucide-roblox/releases/latest/download/lucide-roblox.luau"

local Lucide
local lucideLoadAttempted = false

local function getLucide()
	if Lucide then return Lucide end
	if lucideLoadAttempted then return nil end
	lucideLoadAttempted = true

	local success, result = pcall(function()
		local source = game:HttpGet(LUCIDE_MODULE_URL)
		local chunk, compileError = loadstring(source)
		if not chunk then error(compileError or "Failed to compile Lucide.") end
		return chunk()
	end)

	if success and typeof(result) == "table" then
		Lucide = result
		return Lucide
	end

	warn("[Burbanks] Lucide failed to load:", result)
	return nil
end

