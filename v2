			})
		else
			knob.Position = position
			knob.BackgroundColor3 = color
			track.BackgroundColor3 = options.toggled and self.library.theme.AccentDark or self.library.theme.Background2
		end
	end

	bindThemeRefresh(self.library, function()
		refresh(false)
	end)

	button.MouseButton1Click:Connect(function()
		options.toggled = not options.toggled
		refresh(true)
		safeCall(options.callback, options.toggled)
	end)

