	title.Position = UDim2.fromOffset(38, 0)
	title.Size = UDim2.new(1, -48, 1, 0)
	bindTheme(self, title, "TextColor3", "Muted")
	title.TextTransparency = 0.5

	local container = create("ScrollingFrame", {
		Parent = self.content,
		Position = UDim2.fromOffset(16, 68),
		Size = UDim2.new(1, -32, 1, -84),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 0,
		Visible = false,
	})

	local layout = create("UIListLayout", {
		Parent = container,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
	})
	refreshCanvas(container, layout, 12)

	page.button = button
	page.background = background
	page.accent = accent
	page.icon = icon
	page.buttonTitle = title
	page.container = container

	self.pages[#self.pages + 1] = page
	button.LayoutOrder = #self.pages

	button.MouseEnter:Connect(function()
		if self.focusedPage ~= page then
			tween(background, 0.15, {BackgroundTransparency = 0.85})
		end
	end)

	button.MouseLeave:Connect(function()
		if self.focusedPage ~= page then
			tween(background, 0.15, {BackgroundTransparency = 1})
		end
	end)

	button.MouseButton1Click:Connect(function()
		self:SelectPage({page = page})
	end)

	bindThemeRefresh(self, function()
		local selected = self.focusedPage == page
		page.buttonTitle.TextColor3 = selected and self.theme.Text or self.theme.Muted
		page.buttonTitle.TextTransparency = selected and 0 or 0.5

		if page.icon:IsA("ImageLabel") or page.icon:IsA("ImageButton") then
			page.icon.ImageColor3 = selected and self.theme.Accent or self.theme.Muted
		else
			page.icon.TextColor3 = selected and self.theme.Accent or self.theme.Muted
			page.icon.TextTransparency = selected and 0 or 0.5
		end
	end)

	if #self.pages == 1 then
		self:SelectPage({page = page})
	end

	return page
end
