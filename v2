function Section:addColorPicker(data)
	data = data or {}

	local options = {
		title = tostring(data.title or data.Title or "COLOR"),
		color3 = typeof(data.default) == "Color3" and data.default or self.library.theme.Accent,
		callback = data.callback or data.Callback or function() end,
	}

	local module = createBoxedModule(self, 40)
	module.ClipsDescendants = true

	local header = create("TextButton", {
		Parent = module,
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	})

	local title = createBoxedTitle(self, header, options.title, 78)

	local preview = create("Frame", {
		Parent = header,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(50, 18),
		BorderSizePixel = 0,
		BackgroundColor3 = options.color3,
	})
	corner(preview, 6)

	local previewStroke = stroke(preview, self.library.theme.Stroke, 0.5, 1)
	bindTheme(self.library, previewStroke, "Color", "Stroke")

	local inputs = create("Frame", {
		Parent = module,
		Position = UDim2.fromOffset(8, 42),
		Size = UDim2.new(1, -16, 0, 28),
		BackgroundTransparency = 1,
		Visible = false,
	})

	create("UIListLayout", {
		Parent = inputs,
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
	})

	local boxes = {}

	for _, channel in ipairs({"R", "G", "B"}) do
		local box = create("TextBox", {
			Parent = inputs,
			Size = UDim2.new(0.32, -4, 1, 0),
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = Enum.Font.GothamBold,
			Text = "255",
			TextSize = 10,
		})
		bindTheme(self.library, box, "BackgroundColor3", "Background2")
		box.BackgroundTransparency = 0
		bindTheme(self.library, box, "TextColor3", "Text")
		box.TextTransparency = 0.35
		corner(box, 6)
		boxes[channel] = box
	end

	local apply = create("TextButton", {
		Parent = module,
		Position = UDim2.fromOffset(8, 76),
		Size = UDim2.new(1, -16, 0, 26),
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "APPLY COLOR",
		TextSize = 10,
		Visible = false,
		AutoButtonColor = false,
	})
	bindTheme(self.library, apply, "BackgroundColor3", "Accent")
	apply.TextColor3 = Color3.fromRGB(4, 12, 18)
	corner(apply, 6)

	local opened = false

	local function updateInputs()
		boxes.R.Text = tostring(math.floor(options.color3.R * 255 + 0.5))
		boxes.G.Text = tostring(math.floor(options.color3.G * 255 + 0.5))
		boxes.B.Text = tostring(math.floor(options.color3.B * 255 + 0.5))
		preview.BackgroundColor3 = options.color3
	end

	local function setOpen(state)
		opened = state == true
		inputs.Visible = opened
		apply.Visible = opened

		tween(module, 0.18, {
			Size = UDim2.new(1, 0, 0, opened and 116 or 40),
		})
	end

	header.MouseButton1Click:Connect(function()
		setOpen(not opened)
	end)

	apply.MouseButton1Click:Connect(function()
		local red = math.clamp(tonumber(boxes.R.Text) or 0, 0, 255)
		local green = math.clamp(tonumber(boxes.G.Text) or 0, 0, 255)
		local blue = math.clamp(tonumber(boxes.B.Text) or 0, 0, 255)

		options.color3 = Color3.fromRGB(red, green, blue)
		updateInputs()
		setOpen(false)
		safeCall(options.callback, options.color3)
	end)

	updateInputs()

	local controller = {
		Instance = module,
		Options = options,
	}

	function controller:Set(color, callCallback)
		if typeof(color) ~= "Color3" then return self end
		options.color3 = color
		updateInputs()
		if callCallback ~= false then
			safeCall(options.callback, options.color3)
		end
		return self
	end

	function controller:Update(newOptions)
		newOptions = newOptions or {}
		if newOptions.title ~= nil then
			options.title = tostring(newOptions.title)
			title.Text = options.title
		end
		if typeof(newOptions.default) == "Color3" then
			self:Set(newOptions.default, false)
		elseif typeof(newOptions.color3) == "Color3" then
			self:Set(newOptions.color3, false)
		end
		if typeof(newOptions.callback) == "function" then
			options.callback = newOptions.callback
		end
		return self
	end

	self.modules[#self.modules + 1] = controller
	return controller
end
