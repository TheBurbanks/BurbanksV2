		Enum.Font.GothamBold
	)
	arrow.AnchorPoint = Vector2.new(1, 0.5)
	arrow.Position = UDim2.new(1, -12, 0.5, 0)
	arrow.Size = UDim2.fromOffset(20, 20)
	arrow.TextXAlignment = Enum.TextXAlignment.Center
	arrow.TextYAlignment = Enum.TextYAlignment.Center
	bindTheme(self.library, arrow, "TextColor3", "Muted")
	arrow.TextTransparency = 0.5

	local search = create("TextBox", {
		Parent = module,
		Position = UDim2.fromOffset(8, 40),
		Size = UDim2.new(1, -16, 0, 26),
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		PlaceholderText = "SEARCH...",
		Text = "",
		Font = Enum.Font.GothamMedium,
		TextSize = 10,
		Visible = false,
	})
	bindTheme(self.library, search, "BackgroundColor3", "Background2")
	search.BackgroundTransparency = 0
	bindTheme(self.library, search, "TextColor3", "Text")
	search.TextTransparency = 0.35
	bindTheme(self.library, search, "PlaceholderColor3", "Muted")
	corner(search, 6)

	local list = create("ScrollingFrame", {
		Parent = module,
		Position = UDim2.fromOffset(8, 72),
		Size = UDim2.new(1, -16, 0, 100),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 0,
		Visible = false,
	})

	local layout = create("UIListLayout", {
		Parent = list,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
	})
	refreshCanvas(list, layout, 5)

	local opened = false

	local function setOpen(state)
		opened = state == true
		search.Visible = opened
		list.Visible = opened

		tween(arrow, 0.15, {
			Rotation = opened and 180 or 0,
			TextColor3 = opened and self.library.theme.Accent or self.library.theme.Muted,
			TextTransparency = opened and 0 or 0.5,
		})

		tween(module, 0.18, {
			Size = UDim2.new(1, 0, 0, opened and 190 or 40),
		})
	end

	local function clearEntries()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
	end

	local function rebuild(filter)
		clearEntries()
		filter = string.lower(tostring(filter or ""))

		for _, value in ipairs(options.list) do
			if filter == "" or string.find(string.lower(value), filter, 1, true) then
				local entry = create("TextButton", {
					Parent = list,
					Size = UDim2.new(1, -3, 0, 28),
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Font = Enum.Font.GothamMedium,
					Text = value,
					TextSize = 10,
				})
				bindTheme(self.library, entry, "BackgroundColor3", "Background2")
				entry.BackgroundTransparency = 0
				bindTheme(self.library, entry, "TextColor3", "Muted")
				entry.TextTransparency = 0.5
				corner(entry, 6)

				entry.MouseEnter:Connect(function()
					tween(entry, 0.12, {
						BackgroundColor3 = self.library.theme.Card,
						TextColor3 = self.library.theme.Text,
						TextTransparency = 0,
					})
					entry.BackgroundTransparency = 0.35
				end)

				entry.MouseLeave:Connect(function()
					tween(entry, 0.12, {
						BackgroundColor3 = self.library.theme.Background2,
						TextColor3 = self.library.theme.Muted,
						TextTransparency = 0.5,
					})
					entry.BackgroundTransparency = 0
				end)

				entry.MouseButton1Click:Connect(function()
					options.selected = value
					title.Text = value
					setOpen(false)
					safeCall(options.callback, value)
				end)
			end
		end
	end

	header.MouseButton1Click:Connect(function()
		setOpen(not opened)
		if opened then
			search.Text = ""
			rebuild("")
		end
	end)

	search:GetPropertyChangedSignal("Text"):Connect(function()
		if opened then
			rebuild(search.Text)
		end
	end)

	rebuild("")

	local controller = {
		Instance = module,
		Options = options,
	}

	function controller:Set(value, callCallback)
		value = tostring(value)
		options.selected = value
		title.Text = value
		if callCallback ~= false then
			safeCall(options.callback, value)
		end
		return self
	end

	function controller:Update(newOptions)
		newOptions = newOptions or {}
		if newOptions.title ~= nil then
			options.title = tostring(newOptions.title)
			if not options.selected then
				title.Text = options.title
			end
		end
		if typeof(newOptions.list) == "table" then
			table.clear(options.list)
			for _, value in ipairs(newOptions.list) do
				options.list[#options.list + 1] = tostring(value)
			end
			rebuild(search.Text)
		end
		if newOptions.default ~= nil then
			self:Set(newOptions.default, false)
		elseif newOptions.selected ~= nil then
			self:Set(newOptions.selected, false)
		end
		if typeof(newOptions.callback) == "function" then
			options.callback = newOptions.callback
		end
		return self
	end

	self.modules[#self.modules + 1] = controller
	return controller
end
